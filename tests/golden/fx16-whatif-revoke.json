{
  "caveats": [
    {
      "id": "C-ISSUED-STATE",
      "text": "Containment steps change paths for future runs only. Sessions already issued stay issued until their TTL; persistent credentials stay in Z until rotated."
    },
    {
      "id": "C-OFFLINE-MODEL",
      "text": "Offline model of the saved report. Nothing was executed and no AWS account, repository or secret store was read or changed."
    },
    {
      "id": "C-REVOKE-1",
      "text": "Sessions issued inside the propagation window (the assumed 30 s before the cutoff) are covered by the deny."
    },
    {
      "id": "C-REVOKE-2",
      "text": "Sessions issued after the cutoff are not covered; a role that can still be assumed yields new sessions."
    },
    {
      "id": "C-REVOKE-3",
      "text": "The deny applies to every user of the role, including legitimate sessions issued before the cutoff."
    },
    {
      "id": "C-REVOKE-4",
      "text": "Service-linked roles cannot be revoked this way."
    },
    {
      "id": "C-REVOKE-5",
      "text": "Derived credentials (chained role sessions, access keys created by the session, secrets already read) are not affected by the deny; role chaining is not modelled, so they are listed as residual_unknown."
    },
    {
      "id": "C-REVOKE-6",
      "text": "The 30 s propagation window is ASSUMED from https://docs.aws.amazon.com/IAM/latest/UserGuide/id_roles_use_revoke-sessions.html (\"approximately 30 seconds into the future\") and is not a guarantee."
    },
    {
      "id": "C-UNKNOWN-EDGES",
      "text": "UNKNOWN-class edges never contribute to R, E or Z; they are reported only as potential."
    }
  ],
