              {
                "name": "read-ci-token",
                "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":[\"ssm:GetParameter\"],\"Resource\":[\"arn:aws:ssm:us-east-1:111122223333:parameter/legacy/ci-token\"]}]}"
              }
            ]
