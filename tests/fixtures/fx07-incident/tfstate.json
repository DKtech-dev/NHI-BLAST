          "address": "aws_iam_openid_connect_provider.github",
          "mode": "managed",
          "type": "aws_iam_openid_connect_provider",
          "name": "github",
          "provider_name": "registry.terraform.io/hashicorp/aws",
          "schema_version": 0,
          "values": {
            "url": "https://token.actions.githubusercontent.com",
            "client_id_list": [
              "sts.amazonaws.com"
